# Copy this file to .env and fill it in.

# ── Required ────────────────────────────────────────────────────────────────

# From platform.armoriq.ai. Starts with ak_live_ or ak_test_.
ARMORIQ_API_KEY=

# Your Gemini key, from aistudio.google.com/apikey
GEMINI_API_KEY=

# ── Names — these must match what you registered on platform.armoriq.ai ─────
# Run `npm run check` to verify they do.

ARMORIQ_AGENT_NAME=ops-copilot
ARMORIQ_MCP_NAME=ops-mcp

# ── Where the MCP server is ─────────────────────────────────────────────────
# The MCP server is a separate repo and a separate deployment:
#   https://github.com/<you>/armoriq-adk-ops-mcp
#
# Local:     http://localhost:8788/mcp
# Deployed:  https://ops-mcp.onrender.com/mcp
MCP_URL=http://localhost:8788/mcp

# ── Optional ────────────────────────────────────────────────────────────────

GEMINI_MODEL=gemini-2.5-flash

# Seconds to wait for a human to approve a held action before refusing it.
APPROVAL_WAIT_SECONDS=60

# Set to 1 to run with NO enforcement, to see what the agent does unguarded.
# DISABLE_ARMORIQ=1
