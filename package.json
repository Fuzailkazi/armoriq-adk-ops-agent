{
  "name": "ops-copilot-agent",
  "version": "1.0.0",
  "private": true,
  "description": "A Google ADK agent governed by the ArmorIQ SDK. Deploy separately from the MCP server.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "tsx src/check-setup.ts",
